ONLINE_KENO_URL=
ONLINE_AVIATOR_URL=

# --- Online Game REST API ---
# Used by game web apps to read/update player balances via /api/online-user/ endpoints
ONLINE_GAME_API_SECRET=your_secure_random_secret_here

# --- Offline App Distribution ---
# OPTION A: Telegram file_id (preferred — bot sends file directly, fast & cached)
# Set via /setapp admin command (reply to .zip file)
OFFLINE_APP_FILE_ID=

# OPTION B: Direct download URL (fallback if file_id not set)
OFFLINE_APP_DOWNLOAD_URL=

# --- SMS Forwarder Webhook ---
# Secret for POST /webhook/sms-forwarder endpoint
SMS_WEBHOOK_SECRET=your_sms_webhook_secret

# --- Render.com Deployment ---
# Your Render service URL (auto-set by Render, but add manually for keep-alive cron)
RENDER_EXTERNAL_URL=https://your-bot-name.onrender.com
PORT=3000
